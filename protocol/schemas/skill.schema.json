{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraclaw.dev/schemas/skill.json",
  "title": "Skill Messages",
  "description": "Skill execution messages for running built-in skills on the game side.",

  "skill_execute": {
    "type": "object",
    "required": ["skill_name", "params"],
    "properties": {
      "skill_id": {
        "type": "string",
        "format": "uuid",
        "description": "Unique skill execution ID. Generated by runtime if not provided."
      },
      "skill_name": {
        "type": "string",
        "enum": [
          "mine_vein", "navigate_to", "escape_water", "fight_enemy",
          "loot_chest", "return_home", "build_bridge", "dig_tunnel",
          "collect_items", "illuminate_area"
        ]
      },
      "params": {
        "type": "object",
        "description": "Skill-specific parameters."
      },
      "priority": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3,
        "default": 1
      },
      "timeout_ms": {
        "type": "integer",
        "minimum": 0,
        "maximum": 600000,
        "default": 120000
      }
    }
  },

  "skill_cancel": {
    "type": "object",
    "required": ["skill_id"],
    "properties": {
      "skill_id": {
        "type": "string",
        "format": "uuid"
      }
    }
  },

  "skill_result": {
    "type": "object",
    "required": ["skill_id", "status"],
    "properties": {
      "skill_id": {
        "type": "string",
        "format": "uuid"
      },
      "status": {
        "type": "string",
        "enum": ["completed", "failed", "cancelled", "timeout", "precondition_failed"]
      },
      "result": {
        "type": "object",
        "description": "Skill-specific result data."
      },
      "error": {
        "type": "object",
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      },
      "tick_started": {"type": "integer"},
      "tick_completed": {"type": "integer"},
      "duration_ms": {"type": "integer"}
    }
  },

  "skill_progress": {
    "type": "object",
    "required": ["skill_id", "progress", "current_step"],
    "properties": {
      "skill_id": {
        "type": "string",
        "format": "uuid"
      },
      "progress": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      },
      "current_step": {
        "type": "string",
        "description": "Human-readable description of the current step."
      }
    }
  },

  "skill_param_schemas": {
    "mine_vein": {
      "required": ["target_x", "target_y"],
      "properties": {
        "target_x": {"type": "integer"},
        "target_y": {"type": "integer"},
        "ore_type": {"type": "string"},
        "max_blocks": {"type": "integer", "minimum": 1, "maximum": 500}
      }
    },
    "navigate_to": {
      "required": ["target_x", "target_y"],
      "properties": {
        "target_x": {"type": "integer"},
        "target_y": {"type": "integer"},
        "allow_mining": {"type": "boolean", "default": true},
        "allow_placing": {"type": "boolean", "default": true},
        "max_duration_ms": {"type": "integer"}
      }
    },
    "fight_enemy": {
      "properties": {
        "target_type": {"type": "string"},
        "target_npc_id": {"type": "integer"},
        "style": {"type": "string", "enum": ["melee", "ranged", "magic", "flee"]},
        "max_duration_ms": {"type": "integer"}
      }
    },
    "loot_chest": {
      "required": ["chest_x", "chest_y"],
      "properties": {
        "chest_x": {"type": "integer"},
        "chest_y": {"type": "integer"},
        "take_all": {"type": "boolean", "default": true},
        "filter": {"type": "array", "items": {"type": "string"}}
      }
    },
    "return_home": {
      "properties": {
        "method": {"type": "string", "enum": ["magic_mirror", "recall_potion", "walk", "auto"]},
        "home_x": {"type": "integer"},
        "home_y": {"type": "integer"}
      }
    }
  }
}
