{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraclaw.dev/schemas/error.json",
  "title": "Error Messages",
  "description": "Error responses from either side.",

  "error": {
    "type": "object",
    "required": ["error_code", "message"],
    "properties": {
      "error_code": {
        "type": "string",
        "enum": [
          "PROTOCOL_ERROR",
          "AUTH_FAILED",
          "ACTION_INVALID",
          "ACTION_BUSY",
          "ACTION_TIMEOUT",
          "ACTION_NOT_FOUND",
          "SKILL_NOT_FOUND",
          "SKILL_PRECONDITION",
          "SKILL_BUSY",
          "RATE_LIMITED",
          "OBSERVATION_DISABLED",
          "INTERNAL_ERROR",
          "NOT_IMPLEMENTED",
          "VERSION_MISMATCH"
        ]
      },
      "message": {
        "type": "string",
        "description": "Human-readable error description."
      },
      "details": {
        "type": "object",
        "description": "Additional error context (action_id, skill_name, etc.)."
      }
    }
  }
}
