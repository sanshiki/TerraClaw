{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://terraclaw.dev/schemas/observation.json",
  "title": "Observation Messages",
  "description": "Game state observations sent from game to runtime.",

  "agent_observation_state": {
    "type": "object",
    "required": ["sequence", "tick", "timestamp_ms", "agent"],
    "properties": {
      "sequence": {
        "type": "integer",
        "minimum": 0,
        "description": "Monotonically increasing observation sequence number."
      },
      "tick": {
        "type": "integer",
        "minimum": 0,
        "description": "Game tick when this observation was captured."
      },
      "timestamp_ms": {
        "type": "integer",
        "description": "Wall-clock timestamp in milliseconds."
      },
      "agent": {
        "type": "object",
        "required": ["position", "velocity"],
        "properties": {
          "position": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          },
          "velocity": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "number"},
              "y": {"type": "number"}
            }
          },
          "tile_position": {
            "type": "object",
            "properties": {
              "x": {"type": "integer"},
              "y": {"type": "integer"}
            }
          },
          "direction": {
            "type": "string",
            "enum": ["left", "right"]
          }
        }
      },
      "world": {
        "type": "object",
        "properties": {
          "time": {
            "type": "object",
            "properties": {
              "hour": {"type": "number"},
              "minute": {"type": "number"},
              "is_day": {"type": "boolean"}
            }
          },
          "weather": {
            "type": "string",
            "enum": ["clear", "rain", "storm", "blizzard", "sandstorm", "slime_rain"]
          },
          "biome": {"type": "string"},
          "depth_layer": {
            "type": "string",
            "enum": ["sky", "surface", "underground", "cavern", "underworld"]
          },
          "active_events": {
            "type": "array",
            "items": {"type": "string"}
          },
          "bosses_alive": {
            "type": "array",
            "items": {"type": "string"}
          },
          "invasion": {
            "type": ["string", "null"]
          },
          "hardmode": {"type": "boolean"}
        }
      },
      "spatial_window": {
        "type": "object",
        "properties": {
          "center": {
            "type": "object",
            "required": ["x", "y"],
            "properties": {
              "x": {"type": "integer"},
              "y": {"type": "integer"}
            }
          },
          "radius": {"type": "integer", "minimum": 5, "maximum": 100},
          "tiles": {
            "type": "object",
            "properties": {
              "solids": {
                "type": "string",
                "description": "Base64-encoded run-length-encoded solid tile data."
              },
              "walls": {
                "type": "string",
                "description": "Base64-encoded RLE wall data."
              },
              "liquids": {
                "type": "string",
                "description": "Base64-encoded RLE liquid data."
              },
              "interesting": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["pos", "type"],
                  "properties": {
                    "pos": {
                      "type": "object",
                      "required": ["x", "y"],
                      "properties": {
                        "x": {"type": "integer"},
                        "y": {"type": "integer"}
                      }
                    },
                    "type": {"type": "string"},
                    "quantity": {"type": "integer"},
                    "id": {"type": "integer"},
                    "label": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      },
      "entities": {
        "type": "object",
        "properties": {
          "npcs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "position"],
              "properties": {
                "id": {"type": "integer"},
                "type": {"type": "string"},
                "position": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": {"type": "number"},
                    "y": {"type": "number"}
                  }
                },
                "health": {
                  "type": "object",
                  "properties": {
                    "current": {"type": "integer"},
                    "max": {"type": "integer"}
                  }
                },
                "is_hostile": {"type": "boolean"},
                "is_boss": {"type": "boolean"},
                "ai_state": {"type": "string"},
                "distance_to_center": {"type": "number"}
              }
            }
          },
          "items_on_ground": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type", "position"],
              "properties": {
                "id": {"type": "integer"},
                "type": {"type": "string"},
                "stack": {"type": "integer"},
                "position": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": {"type": "number"},
                    "y": {"type": "number"}
                  }
                },
                "distance_to_center": {"type": "number"}
              }
            }
          },
          "projectiles": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "position", "velocity"],
              "properties": {
                "type": {"type": "string"},
                "position": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": {"type": "number"},
                    "y": {"type": "number"}
                  }
                },
                "velocity": {
                  "type": "object",
                  "required": ["x", "y"],
                  "properties": {
                    "x": {"type": "number"},
                    "y": {"type": "number"}
                  }
                },
                "is_hostile": {"type": "boolean"},
                "damage": {"type": "integer"}
              }
            }
          }
        }
      }
    }
  }
}
